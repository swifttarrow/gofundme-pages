# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gosupportme

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# API Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# JWT Secret (change in production!)
JWT_SECRET=gosupportme-dev-secret-change-in-production
DEV_AUTH_PASSWORD=gosupportme-dev-password

# CORS
CORS_ORIGIN=http://localhost:3000

# Next.js Public
NEXT_PUBLIC_API_URL=http://localhost:3001
