                    {
                      "type": "text",
                      "id": "J52Dw",
                      "name": "storyText",
                      "fill": "$--text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "On the evening of March 2nd, the Martinez family lost their home to an unexpected electrical fire. Carlos, Maria, and their three children — ages 4, 7, and 12 — escaped with only the clothes on their backs. The fire destroyed everything: their belongings, photos, important documents, and the home they had lived in for over 15 years.\n\nThe family is currently staying with relatives while they figure out their next steps. Carlos works as a mechanic and Maria is a teaching assistant at the local elementary school. They are hardworking, loving parents who have always been there for their community.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "normal"
